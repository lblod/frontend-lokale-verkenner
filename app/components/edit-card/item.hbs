<div
  class="au-c-card-item {{if @isGrid 'au-o-grid__item au-u-1-2@medium'}}"
  ...attributes
>
  {{#if (has-block "label")}}
    <div class="au-c-card-item__label">
      <AuLabel
        @inline={{true}}
        @error={{@errorMessage}}
        @warning={{@warningMessage}}
        class={{@labelClass}}
        for={{@labelFor}}
      >
        {{yield to="label"}}
        {{#if @required}}
          <AuPill>Verplicht</AuPill>
        {{/if}}
      </AuLabel>
    </div>
  {{/if}}

  {{#if (has-block "helpText")}}
    <AuHelpText @skin="tertiary">
      <AuIcon @icon="info-circle" />{{~yield to="helpText"~}}
    </AuHelpText>
  {{/if}}

  {{#if (has-block "content")}}
    <div class="au-c-card-item__content">
      {{yield @errorMessage to="content"}}

      {{#if @errorMessage}}
        {{#if (has-block "error")}}
          {{yield @errorMessage to="error"}}
        {{else}}
          <AuHelpText @error={{true}}>{{@errorMessage}}</AuHelpText>
        {{/if}}
      {{else if @warningMessage}}
        <AuHelpText @warning={{true}}>{{@warningMessage}}</AuHelpText>
      {{/if}}
    </div>
  {{/if}}
</div>