{{page-title this.title}}
{{breadcrumb this.crumb route="aanvragen.aanvraag" model=this.request.id}}

{{#if this.model.error}}
  <div class="au-o-box">
    <AuAlert
      @skin="error"
      @icon="alert-triangle"
      @title="De aanvraag kan niet getoond worden"
      data-test-request-error
    >
      <p>{{this.model.error.message}}</p>
      <AuLink @route="aanvragen.index">Naar alle aanvragen</AuLink>
    </AuAlert>
  </div>
{{else}}
  <SidebarContainer>
    <:sidebar>
      <div class="au-c-sidebar">
        <div class="au-c-sidebar__content">
          <div class="au-c-sidebar__header">
            <AuHeading
              @level="4"
              @skin="4"
              class="au-u-medium"
              data-test-request-name
            >
              {{this.requestName}}
            </AuHeading>
          </div>
          <ul class="au-c-list-navigation">
            <li class="au-c-list-navigation__item">
              <AuNavigationLink @route="aanvragen.aanvraag.index">
                Aanvraagformulier
              </AuNavigationLink>
            </li>
            <li class="au-c-list-navigation__item">
              <AuNavigationLink @route="aanvragen.aanvraag.geschiedenis">
                Aanvraaggeschiedenis
              </AuNavigationLink>
            </li>
          </ul>
        </div>
      </div>
    </:sidebar>
    <:content>
      <div class="au-o-box">
        {{#if this.isFormPage}}
          <PageHeader class="au-u-margin-bottom">
            <:title>
              Aanvraagformulier
              <ChangeRequests::Status
                @status={{this.status}}
                class="au-u-margin-left-small"
                data-test-request-status
              />
              {{#if this.attributes.mine}}
                <AuPill @skin="link" class="au-u-margin-left-tiny">Mijn aanvraag</AuPill>
              {{/if}}
            </:title>
            <:action>
              {{#if this.hasActions}}
                <AuButtonGroup>
                  {{#if this.canApprove}}
                    <AuButton
                      data-test-action="goedkeuring"
                      {{on "click" (fn this.open "goedkeuring")}}
                    >
                      Goedkeuren
                    </AuButton>
                  {{/if}}
                  {{#if this.canReject}}
                    <AuButton
                      @alert={{true}}
                      data-test-action="afkeuring"
                      {{on "click" (fn this.open "afkeuring")}}
                    >
                      Afkeuren
                    </AuButton>
                  {{/if}}
                  {{#if this.canAskInformation}}
                    <AuButton
                      @skin="secondary"
                      data-test-action="informatievraag"
                      {{on "click" (fn this.open "informatievraag")}}
                    >
                      Meer informatie opvragen
                    </AuButton>
                  {{/if}}
                  {{#if this.canAnswer}}
                    <AuButton
                      @icon="comment"
                      @iconAlignment="left"
                      data-test-action="informatieantwoord"
                      {{on "click" (fn this.open "informatieantwoord")}}
                    >
                      Beantwoorden
                    </AuButton>
                  {{/if}}
                  {{#if this.canContest}}
                    <AuButton
                      @skin="secondary"
                      @icon="comment"
                      @iconAlignment="left"
                      data-test-action="betwisting"
                      {{on "click" (fn this.open "betwisting")}}
                    >
                      Beslissing betwisten
                    </AuButton>
                  {{/if}}
                  {{#if this.canWithdraw}}
                    <AuButton
                      @skin="link"
                      @icon="bin"
                      @iconAlignment="left"
                      data-test-action="intrekking"
                      {{on "click" (fn this.open "intrekking")}}
                    >
                      Aanvraag intrekken
                    </AuButton>
                  {{/if}}
                </AuButtonGroup>
              {{/if}}
            </:action>
          </PageHeader>

          {{#if this.hasBanners}}
            <div class="au-o-flow au-o-flow--small au-u-margin-bottom">
              {{#if this.openQuestion}}
                {{#if this.canAnswer}}
                  <AuAlert
                    @skin="warning"
                    @icon="alert-triangle"
                    @title="De reviewer verwacht aanvullende informatie:"
                    data-test-banner="question"
                  >
                    <p>{{this.openQuestion.reason}}</p>
                    <AuButton
                      @skin="link"
                      class="au-u-margin-top-small"
                      {{on "click" (fn this.open "informatieantwoord")}}
                    >
                      Antwoord op aanvullende vraag.
                    </AuButton>
                  </AuAlert>
                {{else}}
                  <AuAlert
                    @skin="info"
                    @icon="question-circle"
                    @title="Aanvullende informatie gevraagd"
                    data-test-banner="question"
                  >
                    {{#if this.openQuestion.reason}}
                      <p>{{this.openQuestion.reason}}</p>
                    {{/if}}
                    <p>De aanvrager heeft nog niet geantwoord.</p>
                  </AuAlert>
                {{/if}}
              {{/if}}

              {{#if this.freshAnswer}}
                <AuAlert
                  @skin="warning"
                  @icon="alert-triangle"
                  @title="De aanvrager heeft de aanvullende informatie bezorgd."
                  data-test-banner="answer"
                >
                  <AuLink @route="aanvragen.aanvraag.geschiedenis">
                    Bekijk de aanvullende informatie.
                  </AuLink>
                </AuAlert>
              {{/if}}

              {{#if this.freshContest}}
                <AuAlert
                  @skin="warning"
                  @icon="comment"
                  @title="De aanvrager betwist de afkeuring"
                  data-test-banner="contest"
                >
                  {{#if this.freshContest.reason}}
                    <p>{{this.freshContest.reason}}</p>
                  {{/if}}
                </AuAlert>
              {{/if}}

              {{#if this.rejection}}
                {{! Skinless AuAlert renders grey }}
                <AuAlert
                  @icon="info-circle"
                  @title="Deze aanvraag is afgekeurd met de volgende reden:"
                  data-test-banner="rejection"
                >
                  {{#if this.rejection.reason}}
                    <p>{{this.rejection.reason}}</p>
                  {{/if}}
                  {{#if this.canContest}}
                    <p>
                      Ga je niet akkoord met de beslissing?
                      <AuButton
                        @skin="link"
                        data-test-action="betwisting-link"
                        {{on "click" (fn this.open "betwisting")}}
                      >
                        Laat het ons weten en leg uit waarom. We bekijken je
                        aanvraag opnieuw.
                      </AuButton>
                    </p>
                  {{/if}}
                </AuAlert>
              {{/if}}

              {{#if this.attributes.error}}
                <AuAlert
                  @skin="error"
                  @icon="alert-triangle"
                  @title="Het doorvoeren van de aanvraag mislukte"
                  data-test-banner="failed"
                >
                  <p>{{this.attributes.error}}</p>
                </AuAlert>
              {{/if}}

              {{#if (and this.decides this.isPending this.conflicts.length)}}
                <AuAlert
                  @skin="warning"
                  @icon="alert-triangle"
                  @title="Intussen gewijzigde gegevens"
                  data-test-banner="conflicts"
                >
                  <p>
                    Sinds de aanvraag werd ingediend zijn gegevens die ze
                    wijzigt door iemand anders aangepast. Je ziet de verschillen
                    bij het goedkeuren.
                  </p>
                </AuAlert>
              {{/if}}
            </div>
          {{/if}}

          <div class="au-o-flow au-o-flow--large">
            <DataCard @headingLevel="2" data-test-requested-by>
              <:title>Aangevraagd door</:title>
              <:card as |Card|>
                <Card.Columns>
                  <:left as |Item|>
                    <Item>
                      <:label>Organisatienaam</:label>
                      <:content>
                        {{#if this.model.requester}}
                          <AuLink
                            @route="organizations.organization"
                            @model={{this.model.requester.id}}
                          >{{this.model.requester.abbName}}</AuLink>
                        {{else}}
                          een organisatie
                        {{/if}}
                      </:content>
                    </Item>
                  </:left>
                </Card.Columns>
              </:card>
            </DataCard>
            {{outlet}}
          </div>
        {{else}}
          {{outlet}}
        {{/if}}
      </div>
    </:content>
  </SidebarContainer>

  {{#if this.openStep}}
    <ChangeRequests::StepModal
      @step={{this.openStep}}
      @request={{this.request}}
      @question={{this.openQuestion.reason}}
      @onClose={{this.close}}
      @onDone={{this.stepTaken}}
      @onApplyFailed={{this.applyFailed}}
    />
  {{/if}}
{{/if}}