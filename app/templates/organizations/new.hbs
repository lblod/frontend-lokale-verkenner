{{page-title "Voeg organisatie toe"}}
{{breadcrumb "Voeg organisatie toe"}}

<div class="au-c-body-container au-c-body-container--scroll">
  <PageHeader class="au-u-margin au-u-margin-bottom-large">
    <:title>Voeg organisatie toe</:title>
    <:action>
      <div class="au-u-text-right">
        <AuButtonGroup class="au-c-button-group--align-right">
          <AuLink @route="organizations" @skin="button-secondary">
            Annuleer
          </AuLink>
          <AuButton
            @loading={{this.submitRequestTask.isRunning}}
            @loadingMessage={{this.submitLabel}}
            type="submit"
            form="organization-creation-form"
            @icon={{if this.appliesAtOnce "add" "send"}}
            @iconAlignment="left"
            data-test-submit-request
          >
            {{this.submitLabel}}
          </AuButton>
        </AuButtonGroup>
        <Error::Save @showSaveError={{this.hasValidationErrors}} />
        <Error::ChangeRequest @message={{this.saveError}} />
      </div>
    </:action>
  </PageHeader>

  {{#unless this.appliesAtOnce}}
    <AuAlert
      @skin="info"
      @icon="info-circle"
      @title="Een nieuwe organisatie wordt gevalideerd door ABB"
      class="au-u-margin au-u-margin-bottom-large"
    >
      Vul de gegevens in van een organisatie die officieel geregistreerd is (met
      een KBO-nummer). Na het versturen valideert ABB de aanvraag; je volgt ze
      op onder "Alle aanvragen".
    </AuAlert>
  {{/unless}}

  <form
    class="au-o-box au-o-flow au-o-flow--large"
    id="organization-creation-form"
    aria-label="organization-creation-form"
    {{on "submit" (perform this.submitRequestTask)}}
  >
    <EditCard @containsRequiredFields={{true}}>
      <:title>Organisatie</:title>
      <:card as |Card|>
        <Card.Columns>
          <:left as |Item|>
            <Item @labelFor="organization-abb-name" @required={{true}}>
              <:label>Naam</:label>
              <:content as |hasError|>
                <TrimInput
                  @width="block"
                  @disabled={{true}}
                  @value={{this.currentOrganizationModel.abbName}}
                  @onUpdate={{fn (mut this.currentOrganizationModel.name)}}
                  @error={{hasError}}
                  id="organization-abb-name"
                />
              </:content>
              <:helpText>
                {{help-text "abbName"}}
              </:helpText>
            </Item>
            <Item
              @labelFor="organization-legal-name"
              @required={{true}}
              @errorMessage={{this.currentOrganizationModel.error.legalName.message}}
            >
              <:label>Juridische naam</:label>
              <:content as |hasError|>
                <TrimInput
                  @width="block"
                  @value={{this.currentOrganizationModel.legalName}}
                  @onUpdate={{this.setNames}}
                  @error={{hasError}}
                  id="organization-legal-name"
                />
              </:content>
              <:helpText>
                {{help-text "legalName"}}
              </:helpText>
            </Item>
            <Item
              @labelFor="organization-alternative-names"
              @required={{false}}
            >
              <:label>Alternatieve naam</:label>
              <:content as |hasError|>
                <TrimInput
                  @width="block"
                  @disabled={{false}}
                  @value={{this.currentOrganizationModel.alternativeName}}
                  @onUpdate={{this.setAlternativeNames}}
                  @error={{hasError}}
                  id="organization-alternative-names"
                />
              </:content>
              <:helpText>
                {{help-text "alternativeNames"}}
              </:helpText>
            </Item>
            <Item
              @labelFor="classification-select"
              @required={{true}}
              @errorMessage={{this.currentOrganizationModel.error.classification.message}}
            >
              <:label>Type organisatie</:label>
              <:content as |hasError|>
                <ClassificationSelect
                  @selected={{this.currentOrganizationModel.classification}}
                  @onChange={{this.organizationConverter}}
                  @restrictForNewOrganizations={{true}}
                  @allowedIds={{this.allowedClassificationIds}}
                  @error={{hasError}}
                  @id="classification-select"
                />
              </:content>
              <:helpText>
                Je kan enkel organisaties aanvragen die je bestuur opricht of
                beheert.
              </:helpText>
            </Item>
            {{#if this.currentOrganizationModel.classification}}
              <Item
                @labelFor="legal-form-select"
                @required={{true}}
                @errorMessage={{this.currentOrganizationModel.error.legalForm.message}}
              >
                <:label>Juridische vorm</:label>
                <:content as |hasError|>
                  <LegalFormSelect
                    @selected={{this.currentOrganizationModel.legalForm}}
                    @onChange={{this.setLegalForm}}
                    @error={{hasError}}
                    @id="legal-form-select"
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if
              (and
                this.currentOrganizationModel.classification
                this.currentOrganizationModel.requiresContentThemes
              )
            }}
              <Item
                @labelFor="content-theme-select"
                @required={{true}}
                @errorMessage={{this.currentOrganizationModel.error.contentThemes.message}}
              >
                <:label>Inhoudelijk thema</:label>
                <:content as |hasError|>
                  <ContentThemeSelect
                    @selected={{this.currentOrganizationModel.contentThemes}}
                    @onChange={{this.setContentThemes}}
                    @error={{hasError}}
                    @id="content-theme-select"
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if
              (requires-additional-qualifications
                this.currentOrganizationModel.classification
              )
            }}
              <Item
                @labelFor="additional-qualifications-select"
                @required={{true}}
                @errorMessage={{this.currentOrganizationModel.error.additionalQualifications.message}}
              >
                <:label>Bijkomende kwalificatie(s)</:label>
                <:content as |hasError|>
                  <AdditionalQualificationsSelect
                    @selected={{this.currentOrganizationModel.additionalQualifications}}
                    @onChange={{fn
                      (mut
                        this.currentOrganizationModel.additionalQualifications
                      )
                    }}
                    @error={{hasError}}
                    @id="additional-qualifications-select"
                  />
                </:content>
              </Item>
              {{#if this.currentOrganizationModel.additionalQualifications}}
                <Item>
                  <:label>Rechtsgrond</:label>
                  <:content>
                    <AuList @divider={{true}} as |Item|>
                      {{#each
                        this.currentOrganizationModel.additionalQualifications
                        as |qualification|
                      }}
                        <Item>
                          {{qualification.legalBasis}}
                        </Item>
                      {{/each}}
                    </AuList>
                  </:content>
                </Item>
              {{/if}}
            {{/if}}
            {{#if
              (or
                this.currentOrganizationModel.isAdministrativeUnit
                this.currentOrganizationModel.isZorgraad
                this.currentOrganizationModel.isRegionaalZorgplatform
                this.currentOrganizationModel.isRegionaalLandschap
                this.currentOrganizationModel.isBosgroep
                this.currentOrganizationModel.isWoonmaatschappij
                this.currentOrganizationModel.isPrivateOcmwAssociation
              )
            }}
              <Item
                @labelFor="locations-select"
                @required={{true}}
                @errorMessage={{this.currentOrganizationModel.error.scope.message}}
              >
                <:label>Werkingsgebied</:label>
                <:content>
                  <LocationMultipleSelect
                    @selected={{this.locations}}
                    @onChange={{this.setLocations}}
                    @disabled={{false}}
                    @error={{this.currentOrganizationModel.error.scope}}
                    @id="locations-select"
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if this.currentOrganizationModel.isIgs}}
              <Item
                @labelFor="expectedEndDate"
                @errorMessage={{this.currentOrganizationModel.error.expectedEndDate.message}}
              >
                <:label>Geplande einddatum</:label>
                <:content as |hasError|>
                  <Datepicker
                    @onChange={{fn
                      (mut this.currentOrganizationModel.expectedEndDate)
                    }}
                    @error={{hasError}}
                  />
                </:content>
              </Item>
              <Item @labelFor="purpose">
                <:label>Doel</:label>
                <:content>
                  <RichTextEditor
                    @onChange={{fn (mut this.currentOrganizationModel.purpose)}}
                    @value={{this.currentOrganizationModel.purpose}}
                  />
                </:content>
              </Item>
            {{/if}}
          </:left>
          <:right as |Item|>
            <Item
              @labelFor="status-select"
              @required={{true}}
              @errorMessage={{this.currentOrganizationModel.error.organizationStatus.message}}
            >
              <:label>Status</:label>
              <:content as |hasError|>
                <OrganizationStatusSelect
                  @selected={{this.currentOrganizationModel.organizationStatus}}
                  @onChange={{fn
                    (mut this.currentOrganizationModel.organizationStatus)
                  }}
                  @error={{hasError}}
                  @id="status-select"
                />
              </:content>
            </Item>
            {{#if
              (and
                this.currentOrganizationModel.classification
                (requires-kbo this.currentOrganizationModel)
              )
            }}
              <Item
                @labelFor="kbo-identifier"
                @errorMessage={{@model.identifierKBO.error.structuredIdentifier}}
                @required={{true}}
              >
                <:label>{{@model.identifierKBO.idName}}</:label>
                <:content as |hasError|>
                  <AuInput
                    @width="block"
                    @error={{hasError}}
                    autocomplete="off"
                    value={{@model.structuredIdentifierKBO.localId}}
                    id="kbo-identifier"
                    class="au-c-input--mask"
                    placeholder="____.___.___"
                    {{au-inputmask
                      options=(hash mask="####.###.###" placeholder="_")
                    }}
                    {{on "input" this.setKbo}}
                  />
                </:content>
                <:helpText>
                  Een nieuwe organisatie wordt toegevoegd nadat ze officieel
                  geregistreerd is en een KBO-nummer heeft.
                </:helpText>
                <:error as |error|>
                  <Error::KboNumber @error={{error}} />
                </:error>
              </Item>
            {{/if}}
            <Item
              @labelFor="sharepoint-identifier"
              @errorMessage={{@model.identifierSharepoint.error.structuredIdentifier.message}}
            >
              <:label>{{@model.identifierSharepoint.idName}}</:label>
              <:content as |hasError|>
                <TrimInput
                  @width="block"
                  @value={{@model.structuredIdentifierSharepoint.localId}}
                  @onUpdate={{fn
                    (mut @model.structuredIdentifierSharepoint.localId)
                  }}
                  @error={{hasError}}
                  id="sharepoint-identifier"
                />
              </:content>
            </Item>
          </:right>
        </Card.Columns>
      </:card>
    </EditCard>

    <EditCard @containsRequiredFields={{false}}>
      <:title>Besluit tot oprichting</:title>
      <:card as |Card|>
        <Card.Columns>
          <:left as |Item|>
            <Item
              @labelFor="change-event-decision-link-0"
              @errorMessage={{@model.decision.error.documentLinks.message}}
            >
              <:label>Link naar het besluit</:label>
              <:content>
                <ChangeEvents::DecisionDocumentLinks
                  @decision={{@model.decision}}
                  @errors={{@model.decision.error.documentLinks}}
                />
              </:content>
              <:helpText>
                Een link naar het besluit waarmee de organisatie werd opgericht,
                bijvoorbeeld op de website van het bestuur.
              </:helpText>
            </Item>
            <Item
              @labelFor="decision-publication-date"
              @errorMessage={{@model.decision.error.publicationDate.message}}
            >
              <:label>Publicatiedatum van het besluit</:label>
              <:content as |hasError|>
                <Datepicker
                  @id="decision-publication-date"
                  @value={{@model.decision.publicationDate}}
                  @onChange={{fn (mut @model.decision.publicationDate)}}
                  @error={{hasError}}
                />
              </:content>
            </Item>
          </:left>
          <:right as |Item|>
            <Item @labelFor="request-reason" @alignTop={{true}}>
              <:label>Toelichting bij de aanvraag</:label>
              <:content>
                <AuTextarea
                  id="request-reason"
                  @width="block"
                  value={{this.reason}}
                  rows="5"
                  {{on "input" this.setReason}}
                />
              </:content>
              <:helpText>
                Optioneel. ABB ziet deze toelichting bij het valideren van de
                aanvraag.
              </:helpText>
            </Item>
          </:right>
        </Card.Columns>
      </:card>
    </EditCard>

    {{#if (editable-contact-data this.currentOrganizationModel)}}
      <Site::ContactEditCard
        @address={{@model.address}}
        @primaryContact={{@model.contact}}
        @secondaryContact={{@model.secondaryContact}}
      >
        <:title>Primaire contactgegevens</:title>
      </Site::ContactEditCard>
    {{else}}
      <div class="au-u-max-width-large">
        <AuHeading @level="3" @skin="5" class="au-u-margin-bottom-tiny">
          Primaire contactgegevens
        </AuHeading>
        <p class="au-u-margin-bottom-small">
          De primaire contactgegevens kunnen niet langer in de Lokale Verkenner
          ingegeven worden. Gelieve de contactgegevens (adres, telefoonnummers,
          e-mail en website) in te geven in de
          <AuLinkExternal
            href="https://controle.contactgegevens.lokaalbestuur.vlaanderen.be/"
          >
            controle omgeving van de contactapp
          </AuLinkExternal>. Deze contactgegevens stromen door naar de Lokale
          Verkenner. De organisaties kunnen hun eigen gegevens nadien zelf
          aanpassen via de Contactapp.
        </p>
      </div>
    {{/if}}
  </form>
</div>