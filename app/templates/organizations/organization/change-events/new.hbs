{{page-title "Nieuwe veranderingsgebeurtenis"}}
{{breadcrumb
  "Nieuwe veranderingsgebeurtenis"
  route="organizations.organization.change-events.new"
  model=(params-for "organizations.organization" param="id")
}}

<div class="au-c-body-container au-c-body-container--scroll">
  <form
    class="au-o-box au-o-flow au-o-flow--large"
    {{on "submit" (perform this.submitRequestTask)}}
  >
    <PageHeader>
      <:title>Voeg veranderingsgebeurtenis toe</:title>
      <:subtitle>{{@model.organization.abbName}}
        ({{@model.organization.classification.label}})</:subtitle>
      <:action>
        <div class="au-u-text-right">
          <AuButtonGroup class="au-c-button-group--align-right">
            <AuLink
              @route="organizations.organization.change-events"
              @skin="button-secondary"
            >
              Annuleer
            </AuLink>
            <AuButton
              @loading={{this.submitRequestTask.isRunning}}
              @loadingMessage={{this.submitLabel}}
              @disabled={{this.submitRequestTask.isRunning}}
              type="submit"
              data-test-submit-request
            >
              {{this.submitLabel}}
            </AuButton>
          </AuButtonGroup>
          <Error::Save @showSaveError={{this.hasValidationErrors}} />
          <Error::ChangeRequest @message={{this.saveError}} />
        </div>
      </:action>
    </PageHeader>

    {{#unless this.appliesAtOnce}}
      <AuAlert
        @skin="info"
        @icon="info-circle"
        @title="Een veranderingsgebeurtenis wordt gevalideerd door ABB"
      >
        Na het versturen valideert ABB de aanvraag; de gegevens van de
        organisatie veranderen pas na goedkeuring. Je volgt de aanvraag op onder
        "Alle aanvragen".
      </AuAlert>
    {{/unless}}

    <EditCard @containsRequiredFields={{true}}>
      <:title>Veranderingsgebeurtenis</:title>
      <:card as |Card|>
        <Card.Columns>
          <:left as |Item|>
            <Item
              @labelFor="change-event-type"
              @required={{true}}
              @errorMessage={{@model.changeEvent.error.type.message}}
            >
              <:label>Type veranderingsgebeurtenis</:label>
              <:content as |hasError|>
                <ChangeEventTypeSelect
                  @id="change-event-type"
                  @selected={{@model.changeEvent.type}}
                  @organizationClassification={{@model.organization.classification}}
                  @excludeIds={{this.excludedTypeIds}}
                  @onChange={{this.setType}}
                  @error={{hasError}}
                />
              </:content>
              <:helpText>
                Een fusie of samenvoeging betreft meerdere organisaties en kan
                nog niet aangevraagd worden.
              </:helpText>
            </Item>
            <Item @labelFor="change-event-description">
              <:label>Beschrijving</:label>
              <:content>
                <AuTextarea
                  @width="block"
                  value={{@model.changeEvent.description}}
                  id="change-event-description"
                  {{on
                    "input"
                    (event-value (fn (mut @model.changeEvent.description)))
                  }}
                />
              </:content>
            </Item>
            {{#if (this.isNameChangeType @model.changeEvent.type)}}
              <Item
                @labelFor="change-event-resulting-name"
                @required={{true}}
                @errorMessage={{@model.changeEvent.error.resultingName.message}}
              >
                <:label>Nieuwe naam</:label>
                <:content as |hasError|>
                  <TrimInput
                    @value={{this.resultingName}}
                    @onUpdate={{fn (mut this.resultingName)}}
                    @width="block"
                    @error={{hasError}}
                    id="change-event-resulting-name"
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if this.isLegalFormChange}}
              <Item
                @labelFor="change-event-legal-form"
                @required={{true}}
                @errorMessage={{@model.changeEvent.error.resultingLegalForm.message}}
              >
                <:label>Nieuwe juridische vorm</:label>
                <:content as |hasError|>
                  <LegalFormSelect
                    @id="change-event-legal-form"
                    @selected={{this.selectedResultingLegalForm}}
                    @onChange={{this.updateResultingLegalForm}}
                    @error={{hasError}}
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if @model.changeEvent.isWerkingsgebiedChangeEvent}}
              <Item
                @labelFor="change-event-scope"
                @required={{true}}
                @errorMessage={{@model.changeEvent.error.resultingScope.message}}
              >
                <:label>Nieuw werkingsgebied</:label>
                <:content as |hasError|>
                  <LocationMultipleSelect
                    @id="change-event-scope"
                    @selected={{this.selectedResultingLocations}}
                    @onChange={{this.updateResultingLocations}}
                    @error={{hasError}}
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if
              (is-additional-qualification-change-event @model.changeEvent)
            }}
              <Item
                @labelFor="change-event-additional-qualifications"
                @required={{true}}
                @errorMessage={{@model.changeEvent.error.resultingAdditionalQualifications.message}}
              >
                <:label>Nieuwe bijkomende kwalificatie(s)</:label>
                <:content as |hasError|>
                  <AdditionalQualificationsSelect
                    @id="change-event-additional-qualifications"
                    @selected={{this.selectedResultingAdditionalQualifications}}
                    @onChange={{this.updateResultingAdditionalQualifications}}
                    @error={{hasError}}
                  />
                </:content>
              </Item>
            {{/if}}
            {{#if @model.changeEvent.requiresDecisionInformation}}
              <Item
                @errorMessage={{@model.decision.error.documentLinks}}
                @labelFor="change-event-decision-link-0"
              >
                <:label>Links naar besluiten</:label>
                <:content>
                  <ChangeEvents::DecisionDocumentLinks
                    @decision={{@model.decision}}
                    @errors={{@model.decision.error.documentLinks}}
                  />
                </:content>
                <:helpText>
                  Een link naar het besluit over deze veranderingsgebeurtenis,
                  bijvoorbeeld op de website van het bestuur.
                </:helpText>
                <:error>
                  {{! The errors are shown under each link }}
                </:error>
              </Item>
            {{/if}}
          </:left>
          <:right as |Item|>
            <Item
              @labelFor="change-event-date"
              @required={{true}}
              @errorMessage={{@model.changeEvent.error.date.message}}
            >
              <:label>Datum veranderingsgebeurtenis</:label>
              <:content as |hasError|>
                <Datepicker
                  @id="change-event-date"
                  @value={{@model.changeEvent.date}}
                  @onChange={{fn (mut @model.changeEvent.date)}}
                  @error={{hasError}}
                />
              </:content>
            </Item>
            {{#if @model.changeEvent.requiresDecisionInformation}}
              <Item
                @labelFor="change-event-decision-publication-date"
                @errorMessage={{@model.decision.error.publicationDate.message}}
              >
                <:label>Datum besluit</:label>
                <:content as |hasError|>
                  <Datepicker
                    @error={{hasError}}
                    @id="change-event-decision-publication-date"
                    @value={{@model.decision.publicationDate}}
                    @onChange={{fn (mut @model.decision.publicationDate)}}
                  />
                </:content>
              </Item>
            {{/if}}
            <Item @labelFor="request-reason" @alignTop={{true}}>
              <:label>Toelichting bij de aanvraag</:label>
              <:content>
                <AuTextarea
                  id="request-reason"
                  @width="block"
                  value={{this.reason}}
                  rows="4"
                  {{on "input" this.setReason}}
                />
              </:content>
              <:helpText>
                Optioneel. ABB ziet deze toelichting bij het valideren van de
                aanvraag.
              </:helpText>
            </Item>
          </:right>
        </Card.Columns>
      </:card>
    </EditCard>
  </form>
</div>